<div class="post-item">
	<a :href="slugify(value.title)">
		<h3 @text="value.title"></h3>
		<p @text="value.description"></p>
	</a>
	<post-meta :@date="value.date" :@tags="value.tags" webc:nokeep></post-meta>
</div>
<style>
.post-item {
	border-radius: 5px;
	padding: var(--edge-margin);
	pointer-events: none;
	margin-bottom: 12px;
	transition: background 0.2s ease-in-out;
}
.post-item h3 {
	margin: 0px;
	padding: 8px 0px;
}
.post-item > a {
	text-decoration: none;
	pointer-events: auto;
	color: var(--main-text-color);
}

.post-item p {
	margin: 0px;
	padding: 0.3em 0 0.5em 0;
}

@media (hover: hover) {
	.post-item:hover {
		background: var(--raised-bg-color);
	}
}

/* The card has `pointer-events: none` with `auto` on the inner link, so
   `:active` never reaches the card itself; `:has()` lets the whole card react
   to a press on the link. */
.post-item:has(> a:active) {
	background: var(--pressed-bg-color);
}

/* Fallback for browsers without `:has()`: the link itself darkens. */
@supports not selector(:has(*)) {
	.post-item > a:active {
		background: var(--pressed-bg-color);
	}
}
</style>
